{
  "headers": [
    { "source": "/card-game", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] },
    {
      "source": "/story",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/card-game/:path*", "destination": "/api/card-game" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
